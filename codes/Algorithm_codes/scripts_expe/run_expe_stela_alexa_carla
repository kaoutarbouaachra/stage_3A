#!/bin/bash

VERSION="2026-07-24d"
#COMMAND_DIR="../../stage_3A/codes/Algorithm_codes/"
COMMAND_DIR="."
INSTANCES_DIR="../setAP"
INSTANCE_SET="setAP"
NB_INSTANCES=125
TIME_PER_INSTANCE=600
SLEEP_BETWEEN_RUNS=30

echo "====== $(date) ====== STARTING EXPE"
echo "====== $(date) ======   Version           : $VERSION"
echo "====== $(date) ======   Instance dir      : $INSTANCES_DIR"
echo "====== $(date) ======   Instance set      : $INSTANCE_SET"
echo "====== $(date) ======   Instance nb       : $NB_INSTANCES"
echo "====== $(date) ======   Time per instance : $TIME_PER_INSTANCE"
sleep 10

cd "$COMMAND_DIR" || { echo "Erreur : répertoire $COMMAND_DIR introuvable"; exit 1; }
mkdir -p logs/expe3
TIME_LIMIT=$TIME_PER_INSTANCE

for i in $(seq -w 1 $NB_INSTANCES); do
  echo
  echo "====== $(date) ====== STARTING ALEXA ON INSTANCE $INSTANCE_SET-$i"
  echo

  timeout -s SIGINT $TIME_PER_INSTANCE \
    python -m alexa.run_alexa \
              --data_dir="$INSTANCES_DIR" \
              --time-limit=3600 \
              "$INSTANCE_SET-$i" 2>&1 | tee "logs/expe3/alexa-$INSTANCE_SET-$i-log.txt"
  echo "====== $(date) ====== DONE ; WRITTEN logs/expe3/alexa-$INSTANCE_SET-$i-log.txt"
  echo "====== $(date) Waiting $SLEEP_BETWEEN_RUNS s for gurobi license release"
  sleep $SLEEP_BETWEEN_RUNS

  echo
  echo "====== $(date) ====== STARTING STELA ON INSTANCE $INSTANCE_SET-$i"
  echo
  timeout -s SIGINT $TIME_PER_INSTANCE \
    python -m stela.main \
              --data_dir="$INSTANCES_DIR" \
              --time-limit=3600 \
              "$INSTANCE_SET-$i" 2>&1 | tee "logs/expe3/stela-$INSTANCE_SET-$i-log.txt"
  echo "====== $(date) ====== DONE ; WRITTEN logs/expe3/stela-$INSTANCE_SET-$i-log.txt"
  echo "====== $(date) Waiting $SLEEP_BETWEEN_RUNS s for gurobi license release"
  sleep $SLEEP_BETWEEN_RUNS

  echo
  echo "====== $(date) ====== STARTING CARLA ON INSTANCE $INSTANCE_SET-$i"
  echo
  timeout -s SIGINT $TIME_PER_INSTANCE \
    python -m carla.main \
              --data_dir="$INSTANCES_DIR" \
              --time-limit=3600 \
              "$INSTANCE_SET-$i" 2>&1 | tee "logs/expe3/carla-$INSTANCE_SET-$i-log.txt"
  echo "====== $(date) ====== DONE ; WRITTEN logs/expe3/carla-$INSTANCE_SET-$i-log.txt"
  echo "====== $(date) Waiting $SLEEP_BETWEEN_RUNS s for gurobi license release"
  sleep $SLEEP_BETWEEN_RUNS

done
