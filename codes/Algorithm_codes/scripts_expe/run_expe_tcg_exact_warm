#!/usr/bin/env bash
# =============================================================================
# scripts_expe/run_warm_campaign.sh
#   TCG-Exact-Warm (stela or carla) over all setAP instances, on p-maestro.
#

# =============================================================================
set -u

# ---- locate: run from Algorithm_codes/ whatever the caller's cwd ------------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CODES_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"     # scripts_expe/ -> Algorithm_codes/
cd "$CODES_DIR" || { echo "cannot cd to $CODES_DIR"; exit 1; }

# ---- config -----------------------------------------------------------------
DATA_DIR="../setAP/"          # setAP instances
MODULE="TCG_Exact.run_TCG_exact_warm"
WARM_ALGO="TCG_DIAG"         
WALL=3600                   # internal per-instance wall cap (s)
MIP=1000                      # per-rank integer-master cap (s)
TIMEOUT_MARGIN=120            # external timeout = WALL + margin (grace for flush)
PYTHON=python3

RESULTS_DIR="results"
N_START=1                     # setAP-001 .. setAP-125
N_END=125

EXT_TIMEOUT=$(( WALL + TIMEOUT_MARGIN ))

# ---- campaign log -> logs/expe4/ -------------------------------------------
CAMP_LOG_DIR="logs/expe4"
mkdir -p "$CAMP_LOG_DIR"
STAMP="$(date '+%Y%m%d_%H%M%S')"
CAMP_LOG="${CAMP_LOG_DIR}/warm_campaign_${STAMP}.log"

# Everything printed below goes to BOTH the terminal and the campaign log.
exec > >(tee -a "$CAMP_LOG") 2>&1

# ---- preflight --------------------------------------------------------------
echo "=================================================================="
echo " TCG-Exact-Warm campaign  |  setAP  |  $(date '+%Y-%m-%d %H:%M:%S')"
echo "   cwd           : $(pwd)"
echo "   wall/instance : ${WALL}s   MIP/rank : ${MIP}s"
echo "   ext timeout   : ${EXT_TIMEOUT}s (SIGINT safety net)"
echo "   seed          : ${WARM_ALGO}"
echo "   campaign log  : ${CAMP_LOG}"
echo "=================================================================="

n_run=0; n_skip_seed=0; n_skip_done=0; n_fail=0

for i in $(seq -w "$N_START" "$N_END"); do
    inst="setAP-${i}"
    seed="${RESULTS_DIR}/${inst}/${WARM_ALGO}/${inst}-srpaths.json"
    summ="${RESULTS_DIR}/${inst}/TCG_EXACT_WARM/${inst}-summary.json"

    # 1. seed must exist, else warm silently falls back to the trivial pool.
    if [[ ! -f "$seed" ]]; then
        echo "[skip] ${inst}: no ${WARM_ALGO} seed ($seed) -- run diag first."
        n_skip_seed=$((n_skip_seed+1))
        continue
    fi

    # 2. restartable: skip only if a COMPLETED (non-interrupted) summary exists.
    if [[ -f "$summ" ]]; then
        interrupted=$($PYTHON -c "import json; \
d=json.load(open('$summ')); print(str(d.get('interrupted', False)).lower())" 2>/dev/null)
        if [[ "$interrupted" == "false" ]]; then
            echo "[done] ${inst}: completed summary exists -- skipping."
            n_skip_done=$((n_skip_done+1))
            continue
        else
            echo "[redo] ${inst}: previous run was interrupted -- re-running."
        fi
    fi

    echo "------------------------------------------------------------------"
    echo "[run ] ${inst}  ($(date '+%H:%M:%S'))"
    timeout -s SIGINT "${EXT_TIMEOUT}" \
        $PYTHON -m "$MODULE" "$inst" \
            --data-dir="$DATA_DIR" \
            --warm-algo "$WARM_ALGO" \
            --wall-time "$WALL" \
            --time-limit "$MIP"
    rc=$?

    if [[ $rc -eq 0 ]]; then
        n_run=$((n_run+1))
    elif [[ $rc -eq 124 ]]; then
        # 124 = external timeout fired past the grace window. The internal SIGINT
        # handler should have flushed already; note it and move on.
        echo "[warn] ${inst}: external timeout (rc=124); verify summary flushed."
        n_run=$((n_run+1))
    else
        echo "[FAIL] ${inst}: exit code ${rc}."
        n_fail=$((n_fail+1))
    fi
done

echo "=================================================================="
echo " Campaign done  |  $(date '+%Y-%m-%d %H:%M:%S')"
echo "   ran/flushed  : ${n_run}"
echo "   skip (done)  : ${n_skip_done}"
echo "   skip (noseed): ${n_skip_seed}"
echo "   failed       : ${n_fail}"
echo "   campaign log : ${CAMP_LOG}"
echo "=================================================================="